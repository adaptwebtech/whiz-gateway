# App
ENV=production
PORT=9877

# App — required by Joi validation schema
DATABASE_URL=postgresql://postgres:postgres@pg:5432/whiz_gateway
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# 👇️ These are the access tokens used to:
# a) Manage the Whiz app itself on the Meta App Panel;
# b) Provide messaging via the original, manual WHATSAPP_META inbox messaging flow
# c) Provide the embedded login via Facebook account for either the Facebook/Instagram flow or the Whatsapp Meta flow via embedded signup.
META_ACCESS_TOKEN=
META_APP_SECRET=
META_GRAPH_URL=
# ⚠️ There are still other app IDs and app secrets for the Instagram-Direct and Messenger-Direct oauth login inbox types.
# ℹ️ These will be placed here (and updated on k8s) later.

# 👇️ These are the verify tokens present on the Gateway and in the webhook configs in the Meta App Panel, send with the GET route verifier webhook payload and used to verify the identity of the sender (Meta).
META_VERIFY_TOKEN= # 👈️ App Meta único (Facebook Login for Business): WHATSAPP_META + MESSENGER + INSTAGRAM_META (whatsapp/messenger/instagram via página FB) -> 8FE02cQcwBZ49bMDB3QtJM5G89ZOXlHevFmOd804ZyVJ7VGQZKMQDZPoMU3ZCefh
IG_VERIFY_TOKEN=   # 👈️ App Instagram separado (Instagram Login direto) -> 8FE02cQcwBZ49bMDB3QtJM5G89ZOXlHevFmOd804ZyVJ7VGQZKMQDZPoMU3ZCefh

# 👇️ This is the secret shared between the Gateway and the receivers of the repassed webhooks (so Whizv2 Servers), to ensure that no one is impersonating the Gateway
CALLBACK_SECRET=
DISPATCH_MAX_RETRIES=5
DISPATCH_BACKOFF_BASE_MS=1000
ADMIN_API_KEY=changeme

# 👇️ Observabilidade Sentry (GlitchTip self-hosted). Todas opcionais.
# Sem SENTRY_DSN o default do código é usado; SENTRY_ENABLED=false desliga tudo.
SENTRY_DSN=http://ab8a70c17b22457791eede26716f4e7b@31.97.27.185:30808/2
SENTRY_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.01
# ⚠️ GlitchTip não ingere Sentry Logs nem trace metrics — deixe em false até que suporte.
SENTRY_ENABLE_LOGS=false
SENTRY_ENABLE_METRICS=false
# SENTRY_RELEASE=whiz-gateway@0.0.1

# Postgres service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=whiz_gateway
POSTGRES_PORT=5432

# Redis service
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# RabbitMQ service
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_ERLANG_COOKIE=changeme
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
