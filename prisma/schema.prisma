// Prisma schema — whiz-gateway (feature gateway-foundation)
// Modelos compartilhados pelas demais features. Ver docs/specs/gateway-foundation.md §6.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Onde a mensagem falhou no fluxo do gateway.
enum StatusFalhaMensagem {
  INBOX_NAO_REGISTRADA
  FALHA_ENFILEIRAMENTO
  NACK_RECEBIDO
  FALHA_ENVIO
  AMBIENTE_INDISPONIVEL
  ASSINATURA_INVALIDA
}

/// Destino lógico do re-envio. IDs fixos (1/2/3), sem autoincrement.
model ambiente {
  id   Int    @id
  nome String
  url  String
  del  Boolean @default(false)

  inboxes                  inboxes[]
  redirecionamentos_webhooks redirecionamentos_webhooks[]
}

/// Caixa que correlaciona um PID a um ambiente.
model inboxes {
  id          String   @id @default(uuid())
  id_ambiente Int

  /// Identificador externo do número/conta na Meta (phone_number_id, page_id, …).
  ///
  /// Único POR AMBIENTE, e não globalmente. `development`, `staging` e
  /// `production` são deployments distintos do whiz atrás do mesmo gateway, e o
  /// mesmo número pode estar cadastrado em mais de um — tipicamente um número de
  /// teste que depois vai para produção.
  ///
  /// Com o `@unique` global que existia aqui, o segundo cadastro batia em 409 e o
  /// whiz, que trata 409 como "já registrado", marcava a inbox como registrada
  /// apontando para a entrada do OUTRO ambiente. Resultado: a inbox aparecia
  /// conectada e os webhooks dela iam para o ambiente errado.
  pid         String
  nome        String
  del         Boolean  @default(false)
  data        DateTime @default(now())

  /// WABA (WhatsApp Business Account) dona do número, quando aplicável.
  ///
  /// Existe para resolver os webhooks de NÍVEL WABA — `account_update`,
  /// `phone_number_quality_update`, `message_template_*` etc. Esses payloads não
  /// trazem `value.metadata.phone_number_id`, então a resolução por `pid` falha e
  /// eles iam todos para a fila de mensagens mortas.
  ///
  /// NÃO é único: uma WABA pode ter vários números, logo várias inboxes. Para o
  /// roteamento isso não importa — o que se procura aqui é o AMBIENTE, e os números
  /// de uma mesma WABA pertencem ao mesmo ambiente.
  waba_id String?

  ambiente              ambiente                @relation(fields: [id_ambiente], references: [id])
  fila_mensagens_mortas fila_mensagens_mortas[]

  /// Um pid por ambiente. O par é o que identifica a caixa de verdade.
  @@unique([pid, id_ambiente])
  /// O roteamento procura por `pid` SEM ambiente (o webhook da Meta não diz de
  /// qual ambiente é), então o índice isolado continua sendo necessário.
  @@index([pid])
  @@index([waba_id])
}

/// Chave de API para autenticação de integrações externas.
model api_keys {
  uid  String   @id @default(uuid())
  name String
  key  String
  salt String
  data DateTime @default(now())
  del  Boolean  @default(false)
}

/// Webhook que falhou em algum ponto do fluxo.
model fila_mensagens_mortas {
  id        String              @id @default(uuid())
  message   Json
  id_inbox  String?
  status    StatusFalhaMensagem
  reenviado Boolean             @default(false)
  del       Boolean             @default(false)
  data      DateTime            @default(now())

  inbox inboxes? @relation(fields: [id_inbox], references: [id])
}

model flow_callbacks_urls {
  uid  String   @id @default(uuid())
  url  String
  data DateTime @default(now())
  del  Boolean  @default(false)
}

model redirecionamentos_webhooks {
  uid            String    @id @default(uuid())
  url            String
  data_expiracao DateTime?
  id_ambiente    Int?
  data           DateTime  @default(now())
  del            Boolean   @default(false)

  ambiente ambiente? @relation(fields: [id_ambiente], references: [id])
}

/// Erro bruto devolvido pela Meta — ou falha de entrega de callback — guardado
/// INTEIRO para diagnóstico posterior.
///
/// Existe porque o log do gateway só registrava o status (`… → 400 (Meta error
/// passthrough)`) e jogava o corpo fora. O corpo é o único lugar onde a Meta
/// escreve o motivo, e sem ele um upload quebrado chegava ao whiz-server como um
/// `Timeout aguardando job de upload do gateway: <jobId>` — três camadas, nenhuma
/// com a causa.
///
/// `chave` é o identificador curto emitido em log no instante do persist: é o que
/// se cola numa query para recuperar o erro inteiro. Registros expiram em 14 dias
/// (`MetaErrorLogsCleanupService`).
model logs_erros_meta {
  id    String @id @default(uuid())
  /// Chave curta de busca (`ERRMETA-<12 hex>`), logada no persist.
  chave String @unique

  /// Onde o erro aconteceu: `forward`, `forwardMultipart`, `forwardBinary` ou `callback`.
  origem   String
  metodo   String
  sub_path String

  /// URL ABSOLUTA de fato requisitada (ou a do callback). O `sub_path` é o que o
  /// caller pediu; esta é a rota que saiu do processo, com base URL e query
  /// string montadas. A distinção não é cosmética: o HMAC check failed do upload
  /// resumível era o `?sig=` do id de sessão faltando na URL final, e `sub_path`
  /// sozinho não mostrava isso.
  url      String?

  /// Status HTTP da resposta. `null` em erro de transporte (nenhuma resposta) e
  /// em erro vindo de webhook, onde não houve requisição nossa.
  status Int?

  /// Código de erro da Meta (131053, 131049, 100…), quando o corpo trouxer um.
  /// Separado do `status` de propósito: misturar os dois arruinaria as duas
  /// consultas — `?status=400` e `?codigo_meta=131053` perguntam coisas
  /// diferentes.
  codigo_meta Int?
  /// Corpo da resposta, sem truncar. `null` em erro de transporte.
  corpo  Json?
  /// Headers enviados, com `Authorization` substituído por `[REDACTED]`.
  requisicao Json?

  /// Job de upload assíncrono correlacionado, quando houver.
  job_id   String?

  /// Identificador do objeto a que o erro se refere, quando não é uma chamada
  /// HTTP: o `wamid` da mensagem, nas falhas de entrega que a Meta reporta por
  /// webhook. É por aqui que se liga o erro à mensagem no whiz.
  referencia String?
  /// Mensagem do erro de transporte / da falha de callback.
  mensagem String?

  data DateTime @default(now())

  @@index([data])
  @@index([job_id])
  @@index([origem])
  @@index([referencia])
  @@index([codigo_meta])
}
